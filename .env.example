# Required for live downloads and changelog. Point to the public application repository.
GITHUB_REPOSITORY_OWNER=
GITHUB_REPOSITORY_NAME=

# Optional server-only token for higher API limits. Never prefix with NEXT_PUBLIC_.
GITHUB_TOKEN=

# Production canonical origin, with scheme and no path. Vercel's production hostname is used as a fallback.
NEXT_PUBLIC_SITE_URL=

# Optional public support email.
PRODUCT_CONTACT_EMAIL=

# Optional JSON array. The first matching rule takes priority. * matches any characters.
# RELEASE_ASSET_MAPPING=[{"pattern":"FileDateEditor-*-windows-x64.exe","platform":"windows","architecture":"x64","format":"setup","minimum":"Windows …"}]

# Optional last-known stable raw GitHub API release objects. Defaults to an empty list.
# GITHUB_RELEASE_FALLBACK_JSON=[]
